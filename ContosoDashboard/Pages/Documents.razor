@page "/documents"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IDocumentService DocumentService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Documents - ContosoDashboard</PageTitle>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>My Documents</h1>
        <label class="btn btn-primary mb-0">
            <i class="bi bi-upload"></i> Select Files
            <InputFile @key="inputKey" OnChange="HandleFilesSelected" multiple accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.jpg,.jpeg,.png" class="d-none" />
        </label>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert @(hasError ? "alert-danger" : "alert-info")">@message</div>
    }

    @if (selectedFiles.Count > 0)
    {
        <div class="card mb-4">
            <div class="card-body">
                <h5>Upload details</h5>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Title</label>
                        <input class="form-control" @bind="title" placeholder="Document title" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Category</label>
                        <select class="form-select" @bind="category">
                            @foreach (var option in DocumentCategories.All)
                            {
                                <option value="@option">@option</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Description</label>
                        <textarea class="form-control" @bind="description"></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Tags</label>
                        <input class="form-control" @bind="tags" placeholder="e.g. planning, finance" />
                    </div>
                </div>
                <div class="mt-3">
                    <button class="btn btn-success" @onclick="UploadFilesAsync" disabled="@isUploading">
                        @(isUploading ? "Uploading..." : $"Upload {selectedFiles.Count} file(s)")
                    </button>
                    <button class="btn btn-link" @onclick="ClearSelection" disabled="@isUploading">Cancel</button>
                </div>
                @if (uploadProgress != null)
                {
                    <div class="progress mt-3" role="progressbar" aria-label="Upload progress" aria-valuenow="@uploadProgress" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar" style="width: @uploadProgress%">@uploadProgress%</div>
                    </div>
                }
            </div>
        </div>
    }

    @if (documents == null)
    {
        <p><em>Loading...</em></p>
    }
    else if (documents.Count == 0)
    {
        <div class="alert alert-secondary">No clean documents found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr><th>Title</th><th>Category</th><th>Uploaded</th><th>Size</th><th>Project</th></tr>
                </thead>
                <tbody>
                    @foreach (var document in documents)
                    {
                        <tr>
                            <td><strong>@document.Title</strong><br /><small class="text-muted">@document.OriginalFileName</small></td>
                            <td>@document.Category</td>
                            <td>@document.UploadedDate.ToLocalTime().ToString("MMM dd, yyyy")</td>
                            <td>@FormatSize(document.FileSize)</td>
                            <td>@(document.Project?.Name ?? "Personal")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private readonly List<IBrowserFile> selectedFiles = new();
    private List<Document>? documents;
    private string title = string.Empty;
    private string category = DocumentCategories.All[0];
    private string? description;
    private string? tags;
    private string? message;
    private bool hasError;
    private bool isUploading;
    private int? uploadProgress;
    private int inputKey;
    private int currentUserId;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var claim = state.User.FindFirst(ClaimTypes.NameIdentifier);
        if (claim != null)
            int.TryParse(claim.Value, out currentUserId);
        await LoadDocumentsAsync();
    }

    private async Task LoadDocumentsAsync()
    {
        if (currentUserId > 0)
            documents = await DocumentService.GetMyDocumentsAsync(currentUserId, new DocumentListQuery());
    }

    private void HandleFilesSelected(InputFileChangeEventArgs args)
    {
        selectedFiles.Clear();
        selectedFiles.AddRange(args.GetMultipleFiles(50));
        title = selectedFiles.Count == 1 ? Path.GetFileNameWithoutExtension(selectedFiles[0].Name) : string.Empty;
        message = null;
        hasError = false;
    }

    private async Task UploadFilesAsync()
    {
        if (currentUserId <= 0 || string.IsNullOrWhiteSpace(title))
        {
            message = "A title is required.";
            hasError = true;
            return;
        }

        isUploading = true;
        hasError = false;
        var results = new List<string>();
        try
        {
            for (var index = 0; index < selectedFiles.Count; index++)
            {
                var selected = selectedFiles[index];
                var fileName = selected.Name;
                var fileSize = selected.Size;
                var contentType = selected.ContentType;
                await using var browserStream = selected.OpenReadStream(DocumentFileValidation.MaxFileSize);
                await using var memoryStream = new MemoryStream();
                await browserStream.CopyToAsync(memoryStream);
                memoryStream.Position = 0;

                var request = new DocumentUploadRequest(title, description, category, tags, null, fileName, contentType, fileSize, memoryStream);
                var result = await DocumentService.UploadAsync(currentUserId, request);
                results.Add(result.Error == null ? $"{fileName}: queued for security scanning." : $"{fileName}: {result.Error}");
                uploadProgress = (index + 1) * 100 / selectedFiles.Count;
            }
            message = string.Join(" ", results);
            await LoadDocumentsAsync();
            ClearSelection();
        }
        catch (Exception exception)
        {
            message = $"Upload failed: {exception.Message}";
            hasError = true;
        }
        finally
        {
            isUploading = false;
        }
    }

    private void ClearSelection()
    {
        selectedFiles.Clear();
        uploadProgress = null;
        inputKey++;
    }

    private static string FormatSize(long size) => size switch
    {
        >= 1024 * 1024 => $"{size / 1024d / 1024d:0.0} MB",
        >= 1024 => $"{size / 1024d:0.0} KB",
        _ => $"{size} bytes"
    };
}
